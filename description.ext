/*
    File: description.ext
    Description: Configuration principale de la mission.
*/

author = "KDC - The Legend";
onLoadName = "Opération RACS";
onLoadMission = "Déploiement des forces du RACS.";
overviewText = "=== AVAILABLE LANGUAGES ===\n\nThe briefing, mission diary, and interface are fully localized in the following languages:\n• English 🇺🇸\n• French 🇫🇷\n• Spanish 🇪🇸\n• German 🇩🇪\n• Italian 🇮🇹\n• Russian 🇷🇺\n• Polish 🇵🇱\n• Turkish 🇹🇷\n• Korean 🇰🇷\n• Japanese 🇯🇵\n• Chinese 🇨🇳\n\n--------------------------------------------------\n\n🌍 Find all O.R.A maps here:\n🔗 https://steamcommunity.com/id/KevinDC404/myworkshopfiles/?appid=107410\n\n--------------------------------------------------\n\n=== OPERATION ROYAL ALLIANCE (ORA) ===\n--- RACS SPECIAL OPERATIONS COMMAND ---\n\nSITREP:\nInsurgent forces have seized control of strategic sectors. Armed cells operate within the civilian population while several critical infrastructures are threatened.\n\nThe Royal Army Corps of Sahrani (RACS) deploys a rapid response unit to restore security, gather intelligence, and neutralize emerging threats.\n\nYou are the vanguard of this operation.\n\n--------------------------------------------------\n\n=== MISSION ===\nConduct special operations behind enemy lines, secure civilian populations, and prevent armed groups from further destabilizing the region.\n\nEach deployment is dynamically generated with randomized operational schedules (time of day) and offers varied objectives, guaranteeing near-limitless replayability.\n\nYou will be deployed on site. Request and manage your mission tasks directly from the action menu (scroll wheel).\n\n--------------------------------------------------\n\n=== TACTICAL COMMAND ===\nTake full control of your squad through the advanced Rules of Engagement (ROE) system:\n• INFILTRATION - Stealth movements, lowered weapons, radio silence.\n• AWARE - Active surveillance and standard operational posture.\n• ASSAULT - Aggressive search for contact, dynamic cover-seeking, and immediate reaction.\n\n--------------------------------------------------\n\n=== RACS SUPPORT ASSETS ===\nCommand puts a UH-60L Black Hawk helicopter and tactical drone support at your disposal capable of providing:\n• Close Air Support (CAS)\n• Tactical extraction\n• Troop transport\n• Smart supply delivery (adaptive ammo resupply)\n• Vehicle slingloading\n• Tactical drone support (UAV surveillance and reconnaissance)\n\n--------------------------------------------------\n\n=== TOTAL IMMERSION ===\n• Dynamic civilian population\n• 3D audio call to prayer (Ezan)\n• Randomized names, identities, and RACS gear\n• AI optimized for urban environments\n• Solo and Coop compatible\n• Fully compatible with Project Injury Reaction (PIR) and ACE3.";
// loadScreen = "images\loadScreen.jpg";

respawn = "BIRD";
respawnDelay = 30;
respawnDialog = 0;
respawnOnStart = -1;

class Revive {
    mode                        = 1;
    requiredItems               = 0;
    spontaneousRecoveryDuration = 18;
    medicSpeedMultiplier        = 2.0;
    forceRespawnTimeout         = 3;
};

corpseManagerMode = 1;
corpseLimit = 30;
corpseRemovalMinTime = 300;
corpseRemovalMaxTime = 600;

wreckManagerMode = 1;
wreckLimit = 15;
wreckRemovalMinTime = 600;
wreckRemovalMaxTime = 1200;

